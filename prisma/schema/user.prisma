model User {
    id           String       @id @default(uuid())
    name         String       @db.VarChar(255)
    email        String       @unique
    password     String
    activestatus ActiveStatus @default(Active)
    role         Role         @default(User)
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt

    profile Profile?

    @@map("users")
}
